@inherits LayoutComponentBase
@inject NavigationManager Navigation

<nav class="navbar">
    <a class="brand" href="">🐀 Remy's Recipes</a>

    <button class="hamburger" type="button" @onclick="ToggleMenu">
        ☰
    </button>

    <div class="nav-links @(menuOpen ? "open" : "")">
        <a href="/" @onclick="CloseMenu">Home</a>
        <a href="/recipes" @onclick="CloseMenu">Recipes</a>
        <a href="/shoppinglist" @onclick="CloseMenu">Shopping List</a>

        <button class="search-icon" type="button" @onclick="ToggleSearch">
            🔍
        </button>

        @if (showSearch)
        {
            <form class="nav-search" @onsubmit="SearchRecipes" @onsubmit:preventDefault>
                <input type="text" placeholder="Search recipes..." @bind="searchText" />
            </form>
        }
    </div>
</nav>

<main class="content">
    @Body
</main>

@code {
    bool showSearch = false;
    bool menuOpen = false;
    string searchText = "";

    void ToggleSearch()
    {
        showSearch = !showSearch;
    }

    void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    void CloseMenu()
    {
        menuOpen = false;
    }

    void SearchRecipes()
    {
        var search = searchText.Trim();

        if (string.IsNullOrWhiteSpace(search))
        {
            Navigation.NavigateTo("/recipes");
        }
        else
        {
            Navigation.NavigateTo($"/recipes?search={Uri.EscapeDataString(search)}");
        }

        CloseMenu();
    }
}
