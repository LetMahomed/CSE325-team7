@page "/shoppinglist"

@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Text.Json

<div class="shopping-page">
    @if (shoppingList == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h2>Shopping List</h2>

        <div class="add-item-form">
            <label>Add an item:</label>
            <input type="number" min="1" value="@newItemQuantity" @oninput="UpdateNewItemQuantity" placeholder="Qty" />
            <select @bind="newItemUnit">
                <option value="Count">Count</option>
                <option value="Cup">Cup(s)</option>
                <option value="Tablespoon">Tablespoon(s)</option>
                <option value="Teaspoon">Teaspoon(s)</option>
                <option value="Ounce">Ounce(s)</option>
                <option value="Pound">Pound(s)</option>
                <option value="Gram">Gram(s)</option>
                <option value="Kilogram">Kilogram(s)</option>
                <option value="Milliliter">Milliliter(s)</option>
                <option value="Liter">Liter(s)</option>
            </select>
            <input type="text" value="@newItemName" @oninput="UpdateNewItemName" placeholder="Item name" />
            <button class="btn-primary" type="button" @onclick="AddItem">Add</button>
        </div>

        <div class="list-actions">
            <button class="btn-secondary" type="button" @onclick="RemoveItems">Delete Checked Items</button>
        </div>

        @if (statusMessage != "")
        {
            <p class="status-message">@statusMessage</p>
        }

        @if (!shoppingList.ShoppingItems.Any())
        {
            <p>No items on shopping list.</p>
        }
        else
        {
            <table class="shopping-table">
                <thead>
                    <tr>
                        <th class="col-check"></th>
                        <th class="col-qty" style="white-space:nowrap;cursor:pointer" @onclick='() => ToggleSort("qty")'>Qty <span>@SortIcon("qty")</span></th>
                        <th class="col-item" style="white-space:nowrap;cursor:pointer" @onclick='() => ToggleSort("item")'>Item <span>@SortIcon("item")</span></th>
                        <th class="col-req" style="white-space:nowrap;cursor:pointer" @onclick='() => ToggleSort("req")'>Recipe Req. <span>@SortIcon("req")</span></th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in SortedItems)
                    {
                        <tr @key="item" class="@(item.IsChecked ? "checked-row" : "")">
                            @if (editingItem == item)
                            {
                                <td></td>
                                <td><input type="number" min="1" @bind="editItemQuantity" class="edit-input-qty" /></td>
                                <td><input type="text" @bind="editItemName" class="edit-input-name" /></td>
                                <td></td>
                                <td class="col-actions">
                                    <button class="btn-primary btn-sm" type="button" @onclick="SaveEdit">Save</button>
                                    <button class="btn-secondary btn-sm" type="button" @onclick="CancelEdit">Cancel</button>
                                </td>
                            }
                            else
                            {
                                <td class="col-check"><input type="checkbox" @bind="item.IsChecked" /></td>
                                <td>@item.Quantity</td>
                                <td class="@(item.IsChecked ? "item-checked" : "")">@item.Name</td>
                                <td class="recipe-req">@item.RecipeRequirement</td>
                                <td class="col-actions">
                                    <button class="btn-secondary btn-sm" type="button" @onclick="() => StartEdit(item)">Edit</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    // --- State ---
    ShoppingListData? shoppingList;

    // Add item form state
    string newItemName = "";
    int newItemQuantity = 1;
    string newItemUnit = "Count";          // Default unit for manually added items
    string statusMessage = "";

    // Inline edit state
    ShoppingItem? editingItem = null;
    string editItemName = "";
    int editItemQuantity = 1;

    // Sort state (defaults to alphabetical by item name)
    string sortColumn = "item";
    bool sortAscending = true;

    /// <summary>
    /// Loads shopping list from localStorage on page init.
    /// Creates empty list if nothing saved.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var savedJson = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            "shoppingList"
        );

        if (!string.IsNullOrWhiteSpace(savedJson))
        {
            shoppingList = JsonSerializer.Deserialize<ShoppingListData>(savedJson) ?? new ShoppingListData();
            shoppingList.ShoppingItems ??= new List<ShoppingItem>();
            await NormalizeShoppingItemIds();
        }
        else
        {
            shoppingList = new ShoppingListData();
        }
    }

    /// <summary>
    /// Removes all checked items from the list and persists changes.
    /// </summary>
    async Task RemoveItems()
    {
        if (shoppingList == null)
            return;

        var removedCount = shoppingList.ShoppingItems.RemoveAll(item => item.IsChecked);

        statusMessage = removedCount == 0
            ? "No checked items to remove."
            : $"Removed {removedCount} item(s).";

        await SaveShoppingList();
    }

    /// <summary>
    /// Adds a new item or merges with existing item if name matches.
    /// Count items set Qty = amount; other units always Qty = 1.
    /// </summary>
    async Task AddItem()
    {
        var itemName = newItemName.Trim();

        if (shoppingList == null || string.IsNullOrWhiteSpace(itemName))
        {
            statusMessage = "Enter an item name first.";
            return;
        }

        if (newItemQuantity < 1)
        {
            statusMessage = "Quantity must be at least 1.";
            return;
        }

        var isCount = newItemUnit == "Count";
        var existing = shoppingList.ShoppingItems
            .FirstOrDefault(i => i.Name.Equals(itemName, StringComparison.OrdinalIgnoreCase));

        if (existing != null)
        {
            var parts = existing.RecipeRequirement.Split(' ', 2);
            if (parts.Length == 2 && double.TryParse(parts[0], out var existingAmount))
            {
                var newTotal = existingAmount + newItemQuantity;
                var unitName = parts[1];
                existing.RecipeRequirement = $"{newTotal} {unitName}";
                if (isCount)
                    existing.Quantity = (int)newTotal;
            }
        }
        else
        {
            shoppingList.ShoppingItems.Add(new ShoppingItem
            {
                Id = shoppingList.ShoppingItems.Any()
                    ? shoppingList.ShoppingItems.Max(item => item.Id) + 1
                    : 1,
                Name = itemName,
                Quantity = isCount ? newItemQuantity : 1,
                IsChecked = false,
                RecipeRequirement = $"{newItemQuantity} {(newItemQuantity == 1 ? newItemUnit : newItemUnit + "s")}"
            });
        }

        newItemName = "";
        newItemQuantity = 1;
        newItemUnit = "Count";
        statusMessage = $"Added {itemName}.";
        StateHasChanged();

        await SaveShoppingList();
    }

    void UpdateNewItemName(ChangeEventArgs e)
    {
        newItemName = e.Value?.ToString() ?? "";
    }

    void UpdateNewItemQuantity(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var quantity) && quantity >= 1)
            newItemQuantity = quantity;
    }

    async Task NormalizeShoppingItemIds()
    {
        if (shoppingList == null)
            return;

        var nextId = 1;
        var changedIds = false;

        foreach (var item in shoppingList.ShoppingItems)
        {
            if (item.Id != nextId)
            {
                item.Id = nextId;
                changedIds = true;
            }
            nextId++;
        }

        if (changedIds)
            await SaveShoppingList();
    }

    void StartEdit(ShoppingItem item)
    {
        editingItem = item;
        editItemName = item.Name;
        editItemQuantity = item.Quantity;
        statusMessage = "";
    }

    void CancelEdit()
    {
        editingItem = null;
        editItemName = "";
        editItemQuantity = 1;
        statusMessage = "";
    }

    async Task SaveEdit()
    {
        if (editingItem == null)
            return;

        var itemName = editItemName.Trim();

        if (string.IsNullOrWhiteSpace(itemName))
        {
            statusMessage = "Enter an item name first.";
            return;
        }

        if (editItemQuantity < 1)
        {
            statusMessage = "Quantity must be at least 1.";
            return;
        }

        editingItem.Name = itemName;
        editingItem.Quantity = editItemQuantity;

        editingItem = null;
        statusMessage = $"Updated {itemName}.";

        await SaveShoppingList();
    }

    /// <summary>
    /// Persists the current shopping list to browser localStorage.
    /// </summary>
    async Task SaveShoppingList()
    {
        if (shoppingList == null)
            return;

        var json = JsonSerializer.Serialize(shoppingList);

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "shoppingList", json);
        }
        catch (Exception ex)
        {
            statusMessage = $"Item added, but browser storage failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Returns shopping items sorted by the active column and direction.
    /// </summary>
    IEnumerable<ShoppingItem> SortedItems
    {
        get
        {
            if (shoppingList == null) return Enumerable.Empty<ShoppingItem>();

            return (sortColumn, sortAscending) switch
            {
                ("qty", true) => shoppingList.ShoppingItems.OrderBy(i => i.Quantity),
                ("qty", false) => shoppingList.ShoppingItems.OrderByDescending(i => i.Quantity),
                ("item", true) => shoppingList.ShoppingItems.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase),
                ("item", false) => shoppingList.ShoppingItems.OrderByDescending(i => i.Name, StringComparer.OrdinalIgnoreCase),
                ("req", true) => shoppingList.ShoppingItems.OrderBy(i => i.RecipeRequirement),
                ("req", false) => shoppingList.ShoppingItems.OrderByDescending(i => i.RecipeRequirement),
                _ => shoppingList.ShoppingItems.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
            };
        }
    }

    void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    string SortIcon(string column)
    {
        if (sortColumn != column) return "↕";
        return sortAscending ? "▲" : "▼";
    }
}
