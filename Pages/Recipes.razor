@page "/recipes"
@inject HttpClient Http

<h1>Recipes</h1>

<div class="recipe-filters">
    <select @onchange="OnCategoryChanged">
        <option value="">All Categories</option>
        @if (recipeData != null)
        {
            @foreach (var category in Categories)
            {
                <option value="@category" selected="@(category == SelectedCategory)">@category</option>
            }
        }
    </select>
</div>

@if (recipeData == null)
{
    <p>Loading...</p>
}
else if (!FilteredRecipes.Any())
{
    <p>No recipes found.</p>
}
else
{
    @foreach (var recipe in FilteredRecipes)
    {
        <div class="recipe-card">
            <h2>@recipe.Name</h2>

            <p>
                <strong>Category:</strong> @recipe.Category
            </p>

            <p>
                <strong>Prep:</strong> @recipe.PrepTime |
                <strong>Cook:</strong> @recipe.CookTime |
                <strong>Servings:</strong> @recipe.Servings
            </p>

            <h4>Ingredients</h4>
            <ul>
                @foreach (var ingredient in recipe.Ingredients)
                {
                    <li>@ingredient.Amount @ingredient.Unit @ingredient.Name</li>
                }
            </ul>

            <h4>Instructions</h4>
            <ol>
                @foreach (var step in recipe.Instructions)
                {
                    <li>@step</li>
                }
            </ol>
        </div>
    }
}

@code {
    private RecipeData? recipeData;
    private string SelectedCategory = "";

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchText { get; set; }

    protected override async Task OnInitializedAsync()
    {
        recipeData = await Http.GetFromJsonAsync<RecipeData>("data/recipes.json");
    }

    private IEnumerable<string> Categories =>
        recipeData?.Recipes
            .Select(r => r.Category)
            .Distinct()
            .OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<Recipe> FilteredRecipes
    {
        get
        {
            if (recipeData == null)
                return Enumerable.Empty<Recipe>();

            var results = recipeData.Recipes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
                results = results.Where(r => r.Category == SelectedCategory);

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search = SearchText.Trim();
                results = results.Where(r =>
                    r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    r.Category.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            return results;
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        SelectedCategory = e.Value?.ToString() ?? "";
    }
}
