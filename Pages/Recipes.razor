@page "/recipes"
@using CSE325_team7.Services
@using Microsoft.JSInterop
@using System.Text.Json
@inject RecipeService RecipeService
@inject IJSRuntime JS

<h1>Recipes</h1>

<div class="recipe-filters">
    <select @onchange="OnCategoryChanged">
        <option value="">All Categories</option>
        @if (recipes != null)
        {
            @foreach (var category in Categories)
            {
                <option value="@category" selected="@(category == SelectedCategory)">@category</option>
            }
        }
    </select>
</div>

@if (statusMessage != "")
{
    <p class="status-message">@statusMessage</p>
}

@if (recipes == null)
{
    <p>Loading...</p>
}
else if (!FilteredRecipes.Any())
{
    <p>No recipes found.</p>
}
else
{
    @foreach (var recipe in FilteredRecipes)
    {
        <div class="recipe-card">
            <h2>@recipe.Name</h2>

            <p>
                <strong>Category:</strong> @recipe.Category
            </p>

            <p>
                <strong>Prep:</strong> @recipe.PrepTime |
                <strong>Cook:</strong> @recipe.CookTime |
                <strong>Servings:</strong> @recipe.Servings
            </p>

            @if (recipe.Reviews.Any())
            {
                <p class="average-rating">
                    <strong>Rating:</strong> @GetStars(recipe) (@recipe.Reviews.Count review@(recipe.Reviews.Count == 1 ? "" : "s"))
                </p>
            }

            <h4>Ingredients</h4>
            <ul>
                @foreach (var ingredient in recipe.Ingredients)
                {
                    <li>@ingredient.Amount @ingredient.Unit @ingredient.Name</li>
                }
            </ul>

            <h4>Instructions</h4>
            <ol>
                @foreach (var step in recipe.Instructions)
                {
                    <li>@step</li>
                }
            </ol>

            <div class="recipe-actions">
                <button class="btn-primary" @onclick="() => AddToShoppingList(recipe)">
                    🛒 Add to Shopping List
                </button>
                <button class="btn-secondary" @onclick="() => ToggleReviewForm(recipe.Id)">
                    ✍️ Add Review
                </button>
            </div>

            @if (reviewingRecipeId == recipe.Id)
            {
                <div class="review-form">
                    @if (reviewError != "")
                    {
                        <p class="review-error">@reviewError</p>
                    }
                    <div class="star-select">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var star = i;
                            <span class="star @(star <= newRating ? "filled" : "")" @onclick="() => newRating = star">★</span>
                        }
                    </div>
                    <textarea placeholder="Add a comment..." @bind="newComment"></textarea>
                    <div class="review-form-actions">
                        <button class="btn-primary" @onclick="() => SubmitReview(recipe)">Submit</button>
                        <button class="btn-secondary" @onclick="() => CancelReview()">Cancel</button>
                    </div>
                </div>
            }

            @if (recipe.Reviews.Any())
            {
                <div class="reviews-section">
                    <h4>Reviews</h4>
                    @foreach (var review in recipe.Reviews.OrderByDescending(r => r.Date))
                    {
                        <div class="review-item">
                            <span class="review-stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                            <span class="review-date">@review.Date.ToString("MMM d, yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="review-comment">@review.Comment</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private List<Recipe>? recipes;
    private string SelectedCategory = "";
    private string statusMessage = "";
    private int? reviewingRecipeId = null;
    private int newRating = 0;
    private string newComment = "";
    private string reviewError = "";

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchText { get; set; }

    protected override async Task OnInitializedAsync()
    {
        recipes = await RecipeService.GetRecipesAsync();
    }

    private IEnumerable<string> Categories =>
        recipes?.Select(r => r.Category)
            .Distinct()
            .OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<Recipe> FilteredRecipes
    {
        get
        {
            if (recipes == null)
                return Enumerable.Empty<Recipe>();

            var results = recipes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
                results = results.Where(r => r.Category == SelectedCategory);

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search = SearchText.Trim();
                results = results.Where(r =>
                    r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    r.Category.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            return results;
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        SelectedCategory = e.Value?.ToString() ?? "";
    }

    private string GetStars(Recipe recipe)
    {
        var avg = recipe.Reviews.Average(r => r.Rating);
        var rounded = (int)Math.Round(avg);
        return new string('★', rounded) + new string('☆', 5 - rounded);
    }

    private void ToggleReviewForm(int recipeId)
    {
        if (reviewingRecipeId == recipeId)
        {
            reviewingRecipeId = null;
        }
        else
        {
            reviewingRecipeId = recipeId;
            newRating = 0;
            newComment = "";
        }
    }

    private async Task SubmitReview(Recipe recipe)
    {
        if (newRating == 0)
        {
            reviewError = "Please select a star rating.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newComment))
        {
            reviewError = "Please add a comment.";
            return;
        }

        reviewError = "";
        recipe.Reviews.Add(new Review
        {
            Rating = newRating,
            Comment = newComment.Trim(),
            Date = DateTime.Now
        });

        await RecipeService.UpdateRecipeAsync(recipe);
        reviewingRecipeId = null;
        newRating = 0;
        newComment = "";
        statusMessage = $"Review added for \"{recipe.Name}\".";
    }

    private void CancelReview()
    {
        reviewingRecipeId = null;
        newRating = 0;
        newComment = "";
        reviewError = "";
    }

    private async Task AddToShoppingList(Recipe recipe)
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", "shoppingList");
        var shoppingList = string.IsNullOrWhiteSpace(json)
            ? new ShoppingListData()
            : JsonSerializer.Deserialize<ShoppingListData>(json) ?? new ShoppingListData();

        shoppingList.ShoppingItems ??= new List<ShoppingItem>();

        var nextId = shoppingList.ShoppingItems.Any()
            ? shoppingList.ShoppingItems.Max(i => i.Id) + 1
            : 1;

        foreach (var ingredient in recipe.Ingredients)
        {
            shoppingList.ShoppingItems.Add(new ShoppingItem
            {
                Id = nextId++,
                Name = ingredient.Name,
                Quantity = 1,
                IsChecked = false,
                RecipeRequirement = $"{ingredient.Amount} {ingredient.Unit}"
            });
        }

        var updatedJson = JsonSerializer.Serialize(shoppingList);
        await JS.InvokeVoidAsync("localStorage.setItem", "shoppingList", updatedJson);

        statusMessage = $"Added {recipe.Ingredients.Count} ingredients from \"{recipe.Name}\" to shopping list.";
    }
}
