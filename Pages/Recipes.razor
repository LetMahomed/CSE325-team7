@page "/recipes"
@inject HttpClient Http

<h1>Recipes</h1>

@if (!FilteredRecipes.Any())
{
    <p>No recipes for "@SearchText"</p>
}
else
{
    @foreach (var recipe in FilteredRecipes)
    {
        <div class="recipe-card">
            <h2>@recipe.Name</h2>

            <p>
                <strong>Category:</strong> @recipe.Category
            </p>

            <p>
                <strong>Prep:</strong> @recipe.PrepTime |
                <strong>Cook:</strong> @recipe.CookTime |
                <strong>Servings:</strong> @recipe.Servings
            </p>

            <h4>Ingredients</h4>
            <ul>
                @foreach (var ingredient in recipe.Ingredients)
                {
                    <li>
                        @ingredient.Amount @ingredient.Unit @ingredient.Name
                    </li>
                }
            </ul>

            <h4>Instructions</h4>
            <ol>
                @foreach (var step in recipe.Instructions)
                {
                    <li>@step</li>
                }
            </ol>
        </div>
    }
}

@code {
    private RecipeData? recipeData;

    protected override async Task OnInitializedAsync()
    {
        recipeData = await Http.GetFromJsonAsync<RecipeData>(
            "data/recipes.json");
    }
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchText { get; set; }

    private IEnumerable<Recipe> FilteredRecipes
    {
        get
        {
            if (recipeData == null)
            {
                return Enumerable.Empty<Recipe>();
            }

            if (string.IsNullOrWhiteSpace(SearchText))
            {
                return recipeData.Recipes;
            }

            var search = SearchText.Trim();

            return recipeData.Recipes.Where(recipe =>
                recipe.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                recipe.Category.Contains(search, StringComparison.OrdinalIgnoreCase));
        }
    }
}